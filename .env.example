# Copy to .env.local. Keep real credentials in that ignored file.
# Neon Console -> Connect -> pooled PostgreSQL connection string.
DATABASE_URL=
# Optional direct string for migrations if supplied by Neon.
DATABASE_DIRECT_URL=

# Existing model server, reachable through a local SSH tunnel.
SPARK_A_BASE_URL=http://127.0.0.1:18001/v1
SPARK_A_MODEL=openai/gpt-oss-120b
SPARK_A_API_KEY=
SPARK_A_ENABLED=true
SPARK_A_CAPACITY=64
SPARK_A_DECISION_GROUP=all
SPARK_A_CITIZEN_ENABLED=false
SPARK_A_CITIZEN_BASE_URL=http://127.0.0.1:18003/v1
SPARK_A_CITIZEN_MODEL=Qwen/Qwen3-4B
SPARK_A_CITIZEN_API_KEY=
SPARK_A_CITIZEN_CAPACITY=8
SPARK_A_CITIZEN_DECISION_GROUP=citizen

SPARK_B_ENABLED=false
SPARK_B_BASE_URL=
SPARK_B_TAILSCALE_HTTP_HOST=
SPARK_B_MODEL=openai/gpt-oss-120b
SPARK_B_API_KEY=
SPARK_B_CAPACITY=64
SPARK_B_DECISION_GROUP=all
SPARK_B_CITIZEN_ENABLED=false
SPARK_B_CITIZEN_BASE_URL=
SPARK_B_CITIZEN_TAILSCALE_HTTP_HOST=
SPARK_B_CITIZEN_MODEL=Qwen/Qwen3-4B
SPARK_B_CITIZEN_API_KEY=
SPARK_B_CITIZEN_CAPACITY=8
SPARK_B_CITIZEN_DECISION_GROUP=citizen

# Hosted HF inference remains disabled until explicitly configured.
HF_TOKEN=
HF_ENABLED=false
AMD_ENABLED=false
AMD_BASE_URL=
AMD_MODEL=Qwen/Qwen3-4B
AMD_API_KEY=
AMD_CAPACITY=1
AMD_DECISION_GROUP=all
AMD_CITIZEN_ENABLED=false
AMD_CITIZEN_BASE_URL=
AMD_CITIZEN_MODEL=Qwen/Qwen3-4B
AMD_CITIZEN_API_KEY=
AMD_CITIZEN_CAPACITY=1
AMD_CITIZEN_DECISION_GROUP=citizen
FAULTLINE_SHARE_URL=
FAULTLINE_SHARE_KEY=
