{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:faultline:decision-choice:v2",
  "title": "Faultline model choice v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["choice", "reason"],
  "properties": {
    "choice": { "type": "integer", "minimum": 0 },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "\\S"
    },
    "values": {
      "description": "Required only for a selected option with bounded integer fields. Keys and bounds must match that exact menu option; fixed options must omit values.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "integer" }
    }
  }
}
