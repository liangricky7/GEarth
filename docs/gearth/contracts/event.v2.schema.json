{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gearth:event:v2",
  "title": "GEarth world event envelope v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "run_id",
    "tick",
    "seq",
    "event_type",
    "source",
    "entity_ids",
    "cause_ids",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "tick": {
      "type": "integer",
      "minimum": 0
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "event_type": {
      "enum": [
        "action_accepted",
        "action_rejected",
        "agent_migrated",
        "border_changed",
        "business_closed",
        "business_started",
        "conflict_costs",
        "conflict_started",
        "diplomatic_offer",
        "diplomatic_response",
        "diplomatic_tension",
        "economy_cycle",
        "election_result",
        "goods_purchased",
        "labor_market",
        "loan_funded",
        "loan_requested",
        "loan_settled",
        "loan_rejected",
        "savings_withdrawn",
        "bank_week",
        "bank_failed",
        "payment_sent",
        "policy_blocked",
        "policy_enacted",
        "policy_proposed",
        "public_report",
        "resource_crisis",
        "run_completed",
        "shipment_delivered",
        "shipment_dispatched",
        "shipment_failed",
        "shipment_rerouted",
        "world_initialized",
        "run_stopped",
        "decision_accounting_started",
        "decision_requested",
        "decision_canceled",
        "enrolled",
        "graduated",
        "loan_guaranteed",
        "owner_debt",
        "plan_set",
        "startup_grant",
        "timeline_forked",
        "experiment_intervention",
        "treasury_borrowed"
      ]
    },
    "source": {
      "enum": [
        "scenario",
        "model",
        "rule",
        "rule_fallback",
        "external_receipt"
      ]
    },
    "entity_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "cause_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "payload": {
      "type": "object"
    }
  }
}
